# =============================================================
#  ai/ · AI 파트 .gitignore (Python)
#
#  OS · IDE · 로그 · 비밀값 규칙은 루트 .gitignore 에 있다.
#  여기에는 파이썬 스택 규칙만 둔다.
# =============================================================

# -------------------------------------------------------------
#  가상환경
# -------------------------------------------------------------
venv/
.venv/
env/

# -------------------------------------------------------------
#  Python 캐시 · 빌드 산출물
# -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# -------------------------------------------------------------
#  모델 가중치 · 학습 산출물
#
#  README 규칙: 가중치는 커밋하지 않는다. 파인튜닝 결과물은
#  GPU 개발 서버에서 EC2 로 파일 복사로 전달한다.
#  recommend/data/ 의 텍스트 데이터(골든 쿼리 · 시드 카탈로그 ·
#  합성 질의)는 커밋 대상이므로 여기서 막지 않는다.
# -------------------------------------------------------------
models/
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# 학습 중간 체크포인트 · 학습 로그 (수 GB 가 될 수 있다)
recommend/training/results/checkpoints/
recommend/training/results/*.log

# 하드 네거티브 삼중항 — mine_hard_negatives.py 가 언제든 다시 만든다.
# 같은 에이전트 설명이 수백 번 반복돼 용량만 크고 정보는 없다.
# 반면 train_pairs / holdout_pairs 는 "어떻게 나눴는지"라는 재현 정보라 커밋한다.
recommend/data/train_triplets.jsonl

# -------------------------------------------------------------
#  실행 중 생기는 파생 파일
#
#  인덱스 스냅샷은 백엔드 데이터로 언제든 재생성되는 캐시다.
# -------------------------------------------------------------
*.npz
index_snapshot.npz
