{
  "schema_id": "biz.market_research@1",
  "catalog_version": "1.0",
  "category": "biz",
  "$defs": {
    "Competitor": {
      "properties": {
        "name": {
          "title": "경쟁사명",
          "type": "string"
        },
        "positioning": {
          "title": "포지션",
          "type": "string"
        },
        "note": {
          "title": "특징",
          "type": "string"
        }
      },
      "required": [
        "name",
        "positioning",
        "note"
      ],
      "title": "Competitor",
      "type": "object"
    },
    "Item": {
      "properties": {
        "label": {
          "title": "항목",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "Item",
      "type": "object"
    }
  },
  "description": "시장 조사 결과 — `competition_level` 이 분기의 기준값이다.",
  "properties": {
    "market_overview_md": {
      "description": "마크다운 허용",
      "title": "시장 개요",
      "type": "string"
    },
    "competitors": {
      "items": {
        "$ref": "#/$defs/Competitor"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "주요 경쟁사",
      "type": "array"
    },
    "trends": {
      "items": {
        "$ref": "#/$defs/Item"
      },
      "maxItems": 5,
      "minItems": 2,
      "title": "최근 트렌드",
      "type": "array"
    },
    "competition_level": {
      "description": "분기 기준값. high 면 차별화 전략, low 면 대중 공략 전략으로 간다",
      "enum": [
        "high",
        "low"
      ],
      "title": "경쟁 강도",
      "type": "string"
    },
    "level_reason": {
      "title": "판정 근거",
      "type": "string"
    }
  },
  "required": [
    "market_overview_md",
    "competitors",
    "trends",
    "competition_level",
    "level_reason"
  ],
  "title": "시장 조사 결과",
  "type": "object"
}
