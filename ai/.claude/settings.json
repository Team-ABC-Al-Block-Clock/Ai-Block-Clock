{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore*)",
      "Bash(git merge-base*)",
      "Bash(git grep*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(wc*)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run python -m src.runner*)",
      "Bash(uv run --no-project --with pyyaml python*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(docker compose*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Edit(**/.env)",
      "Edit(**/*.env)",
      "Edit(**/*.pem)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-secrets.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-ci-yaml.mjs\"",
            "timeout": 90,
            "statusMessage": "CI YAML 검증 중"
          }
        ]
      }
    ]
  }
}
