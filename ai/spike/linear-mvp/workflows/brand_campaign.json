          },
          {
            "id": "n3b", "name": "대중 공략 전략",
            "prompt": "prompts/brand/strategy_mass.md",
            "output_schema_id": "biz.strategy_draft@1",
            "unit_price": 4.5, "base_cost": 3.5, "premium_rate": 0.3
          },
          {
            "id": "n4", "name": "브랜드 전략 보고서",
            "prompt": "prompts/brand/brand_strategy.md",
            "input_schema_id": "biz.strategy_draft@1",
            "output_schema_id": "biz.brand_strategy@1",
            "unit_price": 5.0, "base_cost": 4.0, "premium_rate": 0.25
          }
        ],
        "edges": [
          { "from": "n1", "to": "br1", "port": "market" },
          { "from": "n2", "to": "br1", "port": "product" },
          { "from": "br1", "to": "n3a", "when": true },
          { "from": "br1", "to": "n3b", "when": false },
          { "from": "n3a", "to": "n4" },
          { "from": "n3b", "to": "n4" }
