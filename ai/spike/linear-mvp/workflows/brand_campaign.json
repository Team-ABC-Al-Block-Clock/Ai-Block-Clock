{
  "id": "brand_campaign",
  "name": "브랜딩 + 캠페인 (2단계 · 판매자 3명의 에이전트 조합)",
  "model": null,
  "nodes": [
    {
      "id": "a1",
      "type": "agent",
      "name": "브랜딩 전략 에이전트",
      "owner_name": "김전략 브랜딩",
      "agent": {
        "agent_id": "ag_brand_strategy",
        "owner_id": "u_seller_a",
        "nodes": [
          {
            "id": "n1", "name": "시장 조사",
            "prompt": "../../prompts/brand/01_market_research.md",
            "input": { "sample": "biz.brand_brief@1" },
            "output": { "kind": "json", "sample": "biz.market_research@1" }
          },
          {
            "id": "n2", "name": "제품 분석",
            "prompt": "../../prompts/brand/02_product_analysis.md",
            "input": { "sample": "biz.brand_brief@1" },
            "output": { "kind": "json", "sample": "biz.product_analysis@1" }
          },
          {
            "id": "br1", "name": "경쟁 강도 분기", "type": "branch",
            "condition": { "left": "n1.competition_level", "op": "==", "right": "high" }
          },
          {
            "id": "n3a", "name": "차별화 전략",
            "prompt": "../../prompts/brand/03a_strategy_differentiate.md",
            "output": { "kind": "json", "sample": "biz.strategy_draft@1" }
          },
          {
            "id": "n3b", "name": "대중 공략 전략",
            "prompt": "../../prompts/brand/03b_strategy_mass.md",
            "output": { "kind": "json", "sample": "biz.strategy_draft@1" }
          },
          {
            "id": "n4", "name": "브랜드 전략 보고서",
            "prompt": "../../prompts/brand/04_brand_report.md",
            "output": { "kind": "json", "sample": "biz.brand_strategy@1" }
          }
        ],
        "edges": [
          { "from": "n1", "to": "br1", "port": "market" },
          { "from": "n2", "to": "br1", "port": "product" },
          { "from": "br1", "to": "n3a", "when": true },
          { "from": "br1", "to": "n3b", "when": false },
          { "from": "n3a", "to": "n4" },
          { "from": "n3b", "to": "n4" }
        ]
      }
    },
    {
      "id": "a2",
      "type": "agent",
      "name": "SNS 캠페인 기획 에이전트",
      "owner_name": "이소셜 마케팅",
      "agent": {
        "agent_id": "ag_sns_campaign",
        "owner_id": "u_seller_b",
        "nodes": [
          {
            "id": "c1", "name": "캠페인 기획",
            "prompt": "../../prompts/brand/05_sns_campaign.md",
            "output": { "kind": "json", "sample": "biz.campaign_plan@1" }
          }
        ],
        "edges": []
      }
    },
    {
      "id": "a3",
      "type": "agent",
      "name": "광고 카피 에이전트",
      "owner_name": "박카피 스튜디오",
      "agent": {
        "agent_id": "ag_ad_copy",
        "owner_id": "u_seller_c",
        "nodes": [
          {
            "id": "k1", "name": "광고 카피 작성",
            "prompt": "../../prompts/brand/06_ad_copy.md",
            "output": { "kind": "json", "sample": "biz.ad_copy@1" }
          }
        ],
        "edges": []
      }
    },
    {
      "id": "a4",
      "type": "agent",
      "name": "통합 실행안 에이전트",
      "owner_name": "이소셜 마케팅",
      "agent": {
        "agent_id": "ag_execution_plan",
        "owner_id": "u_seller_b",
        "nodes": [
          {
            "id": "e1", "name": "통합 실행안",
            "prompt": "../../prompts/brand/07_execution_plan.md",
            "output": { "kind": "json", "sample": "biz.execution_plan@1" }
          }
        ],
        "edges": []
      }
    }
  ],
  "edges": [
    { "from": "a1", "to": "a2" },
    { "from": "a1", "to": "a3" },
    { "from": "a2", "to": "a4", "port": "campaign" },
    { "from": "a3", "to": "a4", "port": "copy" }
  ],
  "output": {
    "type": "pdf",
    "template_id": null,
    "title": "브랜딩 통합 실행안"
  }
}
