          {
            "id": "e1", "name": "통합 실행안",
            "prompt": "prompts/brand/execution_plan.md",
            "output_schema_id": "biz.execution_plan@1",
            "unit_price": 5.2, "base_cost": 4.1, "premium_rate": 0.25
          }
        ],
        "edges": []
      }
    }
