            "output_schema_id": "biz.product_analysis@1",
            "unit_price": 3.8, "base_cost": 2.9, "premium_rate": 0.3
          },
          {
            "id": "br1", "name": "경쟁 강도 분기", "type": "branch",
            "condition": { "left": "n1.competition_level", "op": "==", "right": "high" }
          },
          {
            "id": "n3a", "name": "차별화 전략",
            "prompt": "prompts/brand/strategy_differentiation.md",
            "output_schema_id": "biz.strategy_draft@1",
