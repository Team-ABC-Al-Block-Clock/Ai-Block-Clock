  "edges": [
    { "from": "n1", "to": "br1", "port": "market" },
    { "from": "n2", "to": "br1", "port": "product" },
    { "from": "br1", "to": "n3a", "when": true },
    { "from": "br1", "to": "n3b", "when": false },
    { "from": "n3a", "to": "n4" },
    { "from": "n3b", "to": "n4" }
  ],
  "output": {
    "type": "pdf",
    "schema_id": "biz.brand_strategy@1",
    "template_id": null,
    "title": "브랜드 전략 보고서"
  }
