      "owner_id": "u_seller_a", "owner_name": "김전략 브랜딩",
      "unit_price": 4.2, "base_cost": 3.2, "premium_rate": 0.3
    },
    {
      "id": "n2", "name": "제품 분석",
      "prompt": "prompts/brand/product_analysis.md",
      "input_schema_id": "biz.brand_brief@1",
      "output_schema_id": "biz.product_analysis@1",
      "owner_id": "u_seller_a", "owner_name": "김전략 브랜딩",
      "unit_price": 3.8, "base_cost": 2.9, "premium_rate": 0.3
    },
    {
      "id": "br1", "name": "경쟁 강도 분기", "type": "branch",
