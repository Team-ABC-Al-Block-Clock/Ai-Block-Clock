MYSQL_DATABASE=ai_block_clock
MYSQL_USER=ai_block_clock
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306

# 인증의 추가 설정은 Compose 기본값을 사용한다.
# 로컬: localhost:5173 지갑 메시지 / HTTP 쿠키.
# 운영: compose.prod.yaml이 HTTPS 서비스 도메인 / Secure 쿠키로 덮어쓴다.
# 포트·도메인이 달라지면 해당 환경 파일에 아래 이름으로 설정한다.
# WALLET_AUTH_DOMAIN / WALLET_AUTH_URI / WALLET_AUTH_CHAIN_ID / WALLET_AUTH_MESSAGE_TTL
# AUTH_COOKIE_SECURE
# AUTH_SESSION_TIMEOUT

# AI 파트 서비스(추천 엔진 · 실행 엔진). 같은 도커 네트워크에서 컨테이너 이름으로 닿는다.
# 토큰은 두 서비스가 하나를 나눠 쓰고 AI 파트 쪽 값과 같아야 한다. 비우면 헤더 없이 붙고 기동 때 경고를 남긴다.
AI_RECOMMEND_BASE_URL=http://ai-block-clock-recommend:8100
AI_RUNTIME_BASE_URL=http://ai-block-clock-ai-runtime:8000
AI_SERVICE_TOKEN=

# 에이전트 원본 증명(CHN-001/002). 등기부 토큰 주인 지갑(ABC 에이전트 등기부)의 개인키다.
# 등기부 주소는 blockchain.yml 에 기본값이 있어 따로 넣지 않는다.
# 개인키는 서버 backend.env 에만 넣는다. 저장소 · 채팅 · 이슈에 붙이지 않는다.
# 키를 비워 두면 기록을 체인에 보내지 않고 PENDING 으로 쌓아 둔다. 켜려면 키를 넣고 true 로 바꾼다.
SSAFY_AGENT_REGISTRY_SIGNER_PRIVATE_KEY=
AGENT_PROVENANCE_REGISTRATION_ENABLED=false
