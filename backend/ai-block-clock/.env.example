MYSQL_DATABASE=ai_block_clock
MYSQL_USER=ai_block_clock
MYSQL_PASSWORD=local_password
MYSQL_ROOT_PASSWORD=local_root_password
MYSQL_PORT=3306

# 인증의 추가 설정은 Compose 기본값을 사용한다.
# 로컬: localhost:5173 지갑 메시지 / HTTP 쿠키 / 5173·8080 출처 허용.
# 운영: compose.prod.yaml이 HTTPS 서비스 도메인 / Secure 쿠키로 덮어쓴다.
# 포트·도메인이 달라지면 해당 환경 파일에 아래 이름으로 설정한다.
# WALLET_AUTH_DOMAIN / WALLET_AUTH_URI / WALLET_AUTH_CHAIN_ID / WALLET_AUTH_MESSAGE_TTL
# AUTH_COOKIE_SECURE / AUTH_ALLOWED_ORIGINS (CSRF 검증용)
# AUTH_SESSION_TTL
