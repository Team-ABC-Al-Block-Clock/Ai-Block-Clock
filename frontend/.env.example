# 개인 설정이 필요하면 .env.local 로 복사해서 사용한다
#   cp .env.example .env.local
# .local 로 끝나는 파일은 커밋되지 않는다

VITE_APP_NAME=ABC AI Block Clock
VITE_API_BASE_URL=/api
# vite.config.ts 가 loadEnv 로 읽는 빌드타임 전용 값. 번들에 실리지 않으므로
# vite-env.d.ts · lib/env.ts 에는 없다
VITE_API_PROXY_TARGET=http://localhost:8080

# MSW 목 서버 사용 여부
# 값이 없으면 켜진 것으로 본다. 끄려면 false 를 명시해야 한다.
# true  = 백엔드 없이 목 응답으로 개발 (기본값)
# false = VITE_API_PROXY_TARGET 의 실제 백엔드로 요청
#
# 주의: 이 값을 읽어 실제로 목 서버를 띄우는 연동은 아직 없다 (S15P21A403-178).
#       그 전까지 true 로 두어도 요청은 프록시를 타고 나간다.
VITE_USE_MOCK=true