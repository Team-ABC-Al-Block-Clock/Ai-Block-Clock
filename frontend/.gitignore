# =============================================================
#  FE · Node / React / Vite
#  OS · IDE · 비밀값 규칙은 저장소 루트의 .gitignore 를 따른다.
# =============================================================

# 의존성 · 빌드 산출물
node_modules/
dist/
dist-ssr/
coverage/

# 캐시
.eslintcache
.vite/

# Vite 관례상 로컬 전용 파일
*.local

# 디버그 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------------------------------------
#  환경변수 예외
#  루트에서 .env 를 전부 막고 있으므로, 비밀값이 없는
#  공유 설정 파일만 여기서 되살린다.
#  (.env.local 은 루트 규칙에 따라 계속 차단된다)
# -------------------------------------------------------------
!.env.example
