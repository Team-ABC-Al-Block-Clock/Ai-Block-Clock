#!/bin/sh
#
# pre-commit — 커밋 전 검사.
#
#   1. 보호 브랜치(master, develop-*)에 직접 커밋하는 것을 막는다.
#   2. 스테이징된 내용에 충돌 마커·공백 오류가 있는지 본다.
#
# 린트/포맷 검사는 여기서 하지 않는다. 훅은 우회할 수 있어 게이트가 되지 못하고,
# 매 커밋마다 비용을 치르면서 --no-verify 습관을 만들어 commit-msg 검사까지
# 무력화시킨다. 린트는 CI 파이프라인에서 강제한다.
#
# 규칙은 git-workflow.md 1.4 보호 규칙 을 따른다.

FAILED=0

# ---------------------------------------------------------------
#  1. 보호 브랜치 직접 커밋 차단
# ---------------------------------------------------------------
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null)

case "$BRANCH" in
	master|develop-*)
		cat >&2 <<ERR

  ✖ '${BRANCH}' 는 보호 브랜치입니다. 직접 커밋할 수 없습니다.

    작업 브랜치를 만들어 커밋한 뒤 MR로 반영하세요.

      git switch -c feat/작업-내용

    긴급히 우회해야 한다면 --no-verify 를 쓸 수 있지만,
    보호 브랜치는 원격에서도 직접 push가 막혀 있습니다.

ERR
		exit 1
		;;
esac

# 스테이징된 파일 목록 (추가·복사·수정된 것만)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
	exit 0
fi

# ---------------------------------------------------------------
#  2. 충돌 마커 · 공백 오류
# ---------------------------------------------------------------
if ! git diff --cached --check; then
	cat >&2 <<'ERR'

  ✖ 충돌 마커 또는 공백 오류가 있습니다. 위 위치를 확인하세요.

ERR
	FAILED=1
fi

exit "$FAILED"
