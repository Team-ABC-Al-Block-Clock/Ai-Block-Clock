#!/bin/sh
#
# commit-msg — 커밋 메시지가 팀 컨벤션을 지키는지 검사한다.
#
#   [<JIRA-KEY>] <type>: <subject>
#   예) [S15P21A403-15] docs: README 작성
#
# 규칙은 git-workflow.md 3. 커밋 메시지 컨벤션 을 따른다.

MSG_FILE="$1"

JIRA_PROJECT="S15P21A403"
TYPES="feat|fix|docs|style|refactor|test|chore"
SUBJECT_MAX=50

# 주석(#)과 빈 줄을 걷어내고 첫 줄(제목)만 가져온다.
SUBJECT_LINE=$(grep -v '^#' "$MSG_FILE" | grep -v '^[[:space:]]*$' | head -n 1)

# 머지·리버트·fixup 커밋은 Git이 메시지를 자동 생성하므로 검사하지 않는다.
case "$SUBJECT_LINE" in
	Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

PATTERN="^\[${JIRA_PROJECT}-[0-9]+\] (${TYPES}): .+"

if ! printf '%s' "$SUBJECT_LINE" | grep -Eq "$PATTERN"; then
	cat >&2 <<ERR

  ✖ 커밋 메시지가 컨벤션에 맞지 않습니다.

    입력한 메시지: ${SUBJECT_LINE}

    올바른 형식: [<JIRA-KEY>] <type>: <subject>
    예시:        [${JIRA_PROJECT}-15] docs: README 작성
                 [${JIRA_PROJECT}-23] feat: 카카오 로그인 API 연동

    · 이슈 키는 대괄호로 감싸 맨 앞에 둡니다.
    · 이슈 키는 브랜치의 스토리 번호가 아니라 실제 수행한 작업(Task) 번호입니다.
    · type: ${TYPES}
    · type 뒤에는 콜론과 공백 하나를 둡니다.

    자세한 규칙은 git-workflow.md 를 참고하세요.

ERR
	exit 1
fi

# 제목 길이는 막지 않고 경고만 한다.
SUBJECT_TEXT=${SUBJECT_LINE#*: }
SUBJECT_LEN=$(printf '%s' "$SUBJECT_TEXT" | wc -m | tr -d ' ')

if [ "$SUBJECT_LEN" -gt "$SUBJECT_MAX" ]; then
	printf '\n  ! subject 가 %s자입니다. %s자 이내를 권장합니다.\n\n' "$SUBJECT_LEN" "$SUBJECT_MAX" >&2
fi

exit 0
